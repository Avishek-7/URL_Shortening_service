# Docker (LAN-only) defaults
DATABASE_URL=postgresql+asyncpg://shortly:shortly@postgres:5432/shortly
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
FLUSH_CLICKS_INTERVAL_SECONDS=60
CELERY_TIMEZONE=UTC

# Streamlit
API_BASE=http://api:8001
PUBLIC_API_BASE=http://192.168.1.50:8001

# Rate limiting
RATE_LIMIT=5/minute
RATE_LIMIT_BURST=10
